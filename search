# Medication Database Search System
# Usage: ./search [path-to-fixed-width-data]
set -u
medslist="${1:-$(dirname "$0")/sample-data.txt}"
if [[ ! -r "$medslist" ]]; then
  printf 'Cannot read data file: %s\n' "$medslist" >&2
  exit 1
fi
while true; do
  printf 'Enter Medication Code? (to exit enter ZZZ) '
  IFS= read -r code || break
  [[ "$code" == ZZZ ]] && break
  if [[ -z "$code" ]]; then
    printf 'Please enter a medication code.\n'
    continue
  fi
  matchedlines=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    med_section="${line:18:8}"
    if [[ "$med_section" == *"$code"* ]]; then
      matchedlines+=("$line")
    fi
  done < "$medslist"
  if (( ${#matchedlines[@]} == 0 )); then
    printf 'No such Medication Code.\n'
    continue
  fi
  while true; do
    printf 'See Generic Name (G/g) or Dose (D/d)? '
    IFS= read -r answer || exit 0
    case "$answer" in
      [Gg])
        for match_line in "${matchedlines[@]}"; do
          printf '%s : %s\n' "${match_line:18:8}" "${match_line:26:13}"
        done
        break ;;
      [Dd])
        for match_line in "${matchedlines[@]}"; do
          printf '%s : %s\n' "${match_line:18:8}" "${match_line:4:14}"
        done
        break ;;
      *) printf 'Please enter only G or D.\n' ;;
    esac
  done
done
printf 'Goodbye.\n'
